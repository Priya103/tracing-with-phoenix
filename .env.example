# OpenRouter powers BOTH the recommender (Claude via Anthropic-compatible
# endpoint) and the DeepEval judge (openai/gpt-4o-mini). One key wires up
# both sides.
OPENROUTER_API_KEY=

# Optional: use the Anthropic API directly for the recommender instead of
# OpenRouter. If OPENROUTER_API_KEY is set, it wins. The judge configured
# in evaluation/metrics.py still needs OPENROUTER_API_KEY.
ANTHROPIC_API_KEY=

# Optional: override the recommender model. Use bare Claude IDs
# (e.g. claude-sonnet-4-6) for the native Anthropic API, or the
# OpenRouter-namespaced form (e.g. anthropic/claude-sonnet-4.5) when
# routing via OPENROUTER_API_KEY.
RECOMMENDER_MODEL=claude-sonnet-4-6
